URL: /?s=&city=tehran
Paged: 0
Found Posts: 0
Max Num Pages: 0
Post Count: 0
Is 404: No
Visital Total Count: 
Rewrite Rule: 
Request: SELECT SQL_CALC_FOUND_ROWS  Dj3i_posts.ID
					 FROM Dj3i_posts  LEFT JOIN Dj3i_term_relationships ON (Dj3i_posts.ID = Dj3i_term_relationships.object_id)  LEFT JOIN Dj3i_term_relationships AS tt1 ON (Dj3i_posts.ID = tt1.object_id)
					 WHERE 1=1  AND ( 
  Dj3i_posts.ID NOT IN (
				SELECT object_id
				FROM Dj3i_term_relationships
				WHERE term_taxonomy_id IN (6)
			) 
  AND 
  Dj3i_term_relationships.term_taxonomy_id IN (312) 
  AND 
  tt1.term_taxonomy_id IN (312)
) AND ((Dj3i_posts.post_type = 'hospital' AND (Dj3i_posts.post_status = 'publish')) OR (Dj3i_posts.post_type = 'post' AND (Dj3i_posts.post_status = 'publish')) OR (Dj3i_posts.post_type = 'product' AND (Dj3i_posts.post_status = 'publish')))
					 GROUP BY Dj3i_posts.ID
					 ORDER BY Dj3i_posts.post_date DESC
					 LIMIT 0, 12


